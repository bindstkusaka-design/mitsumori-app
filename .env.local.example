# ======================================================
# 見積書作成アプリ 環境変数
# ======================================================

# --- Supabase（必須） ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 受付フォーム /reception（必須。未設定時は /reception 配下を全拒否） ---
RECEPTION_PASSWORD=

# --- Googleスプレッドシート連携（任意。未設定時は自動的にスキップされる） ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# --- 受付登録メール通知（任意。未設定時は自動的にスキップされる） ---
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
